# Articulary.com — environment variables
# Copy to .env.local (gitignored) for local dev, or set in your hosting provider.

# Password for the /admin login
# (httpOnly-cookie password gate; see src/app/admin/page.tsx for the Auth.js upgrade path)
ADMIN_PASSWORD=CHANGE_ME

# Optional: Google Analytics Measurement ID (no value = analytics disabled)
# NEXT_PUBLIC_GA_ID=
